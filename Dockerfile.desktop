FROM node:22-alpine AS relay-builder
WORKDIR /build
COPY package.json ./
COPY src/relay ./src/relay
COPY src/core/broccolidb ./src/core/broccolidb
RUN npx --yes esbuild@0.28.1 src/relay/relay-server.ts --bundle --platform=node --target=node22 --format=esm --outfile=relay.mjs --packages=external
RUN npm install --prefix /runtime --omit=dev --ignore-scripts --no-audit --no-fund ws@8.21.0 pg@8.23.0

FROM node:22-bookworm-slim
ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git openssh-client python3 python3-venv python3-gi gir1.2-gtk-3.0 \
    xvfb x11vnc xfwm4 xfce4-terminal dbus-x11 x11-utils x11-xserver-utils xdotool wmctrl \
    fonts-inter fonts-dejavu-core fonts-liberation fonts-noto-color-emoji adwaita-icon-theme procps tini unzip jq \
    && curl -fsSL "https://dl.google.com/linux/direct/google-chrome-stable_current_${TARGETARCH}.deb" -o /tmp/chrome.deb \
    && apt-get install -y --no-install-recommends /tmp/chrome.deb \
    && rm -f /tmp/chrome.deb && rm -rf /var/lib/apt/lists/*
COPY --from=relay-builder /build/relay.mjs /opt/galx-relay/relay.mjs
COPY --from=relay-builder /runtime/node_modules /opt/galx-relay/node_modules
RUN npm install --global --ignore-scripts --no-audit --no-fund @openai/codex@0.150.1
RUN apt-get update && apt-get install -y --no-install-recommends xclip && rm -rf /var/lib/apt/lists/*
COPY src/relay/desktop/ /opt/galx-desktop/
RUN usermod -l desktop -d /home/operator -m node && groupmod -n desktop node \
    && chmod 755 /opt/galx-desktop/start.sh /opt/galx-desktop/launch-app /opt/galx-desktop/open-app /opt/galx-desktop/galx-relay \
    && ln -s /opt/galx-desktop/open-app /usr/local/bin/galx-open \
    && ln -s /opt/galx-desktop/galx-relay /usr/local/bin/galx-relay \
    && mkdir -p /home/operator/.config /home/operator/workspace /home/operator/.local/bin \
    && cp /opt/galx-desktop/bashrc /home/operator/.bashrc \
    && python3 /opt/galx-desktop/theme.py \
    && chown -R 1000:1000 /home/operator
ENV HOME=/home/operator DISPLAY=:0 LANG=C.UTF-8 \
    XDG_RUNTIME_DIR=/tmp/galx-runtime NPM_CONFIG_PREFIX=/home/operator/.local \
    PATH=/home/operator/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
USER 1000:1000
WORKDIR /home/operator/workspace
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 CMD test -f /tmp/desktop-ready && pgrep -x xfwm4 >/dev/null && pgrep -x x11vnc >/dev/null && DISPLAY=:0 xdpyinfo >/dev/null
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/galx-desktop/start.sh"]
