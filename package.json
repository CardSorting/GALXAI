{
  "name": "galxai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/sdk/index.ts",
  "module": "./src/sdk/index.ts",
  "types": "./src/sdk/index.ts",
  "exports": {
    ".": {
      "types": "./src/sdk/index.ts",
      "default": "./src/sdk/index.ts"
    },
    "./next": {
      "types": "./src/sdk/next.ts",
      "default": "./src/sdk/next.ts"
    },
    "./react": {
      "types": "./src/sdk/react.tsx",
      "default": "./src/sdk/react.tsx"
    },
    "./actions": {
      "types": "./src/sdk/actions.ts",
      "default": "./src/sdk/actions.ts"
    },
    "./middleware": {
      "types": "./src/sdk/edge-interceptor.ts",
      "default": "./src/sdk/edge-interceptor.ts"
    },
    "./intent": {
      "types": "./src/sdk/intent.ts",
      "default": "./src/sdk/intent.ts"
    },
    "./express": {
      "types": "./src/sdk/frameworks/express.ts",
      "default": "./src/sdk/frameworks/express.ts"
    },
    "./ui": {
      "types": "./src/sdk/ui/index.ts",
      "default": "./src/sdk/ui/index.ts"
    },
    "./patch": {
      "types": "./src/sdk/patch.ts",
      "default": "./src/sdk/patch.ts"
    },
    "./state": {
      "types": "./src/sdk/state.ts",
      "default": "./src/sdk/state.ts"
    }
  },
  "engines": {
    "node": "22.x"
  },
  "bin": {
    "galxai": "./bin/galxai.mjs"
  },
  "scripts": {
    "onboard": "node --import tsx scripts/onboard-maintainer.ts",
    "hooks:install": "node --import tsx scripts/setup-git-hooks.ts",
    "dissect:payloads": "node --import tsx scripts/dissect-payloads-and-causal-analysis.ts",
    "bench:180-domains": "node --import tsx scripts/test-broccolidb-150-domain-suite.ts",

    "predev": "kill $(lsof -ti:3000) 2>/dev/null || true",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",

    "lint:design": "npx -y impeccable detect src",
    "design:health": "tsx scripts/verify-design-health.ts",
    "design:hints": "tsx scripts/verify-design-health.ts --hints",
    "design:fix": "tsx scripts/autofix-design-slop.ts",
    "design:scorecard": "tsx scripts/generate-design-scorecard.ts",
    "worker:dev": "wrangler dev",
    "worker:build": "wrangler deploy --dry-run",
    "worker:deploy": "wrangler deploy",
    "worker:deploy:staging": "wrangler deploy --env staging",
    "worker:tail": "wrangler tail",
    "worker:test": "tsx scripts/test-cloudflare-workers.ts",
    "cf:bootstrap": "tsx scripts/bootstrap-cloudflare.ts",
    "stripe:setup": "tsx scripts/setup-stripe-cli.ts",
    "stripe:provision": "tsx scripts/provision-stripe-all.ts",
    "stripe:login": "stripe login",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook",
    "stripe:seed": "tsx scripts/seed-stripe-products.ts",
    "stripe:fixture:products": "stripe fixtures stripe/fixtures/products.json",
    "stripe:trigger:checkout": "stripe trigger checkout.session.completed",
    "stripe:trigger:invoice": "stripe trigger invoice.payment_succeeded",
    "test:stripe": "tsx scripts/test-stripe-integration.ts",
    "test:router": "tsx scripts/validate-galxai-router.ts",
    "test:governance": "node --import tsx scripts/validate-spend-governance.ts",
    "test:broccolidb:hardening": "node --import tsx scripts/test-broccolidb-production-hardening.ts",
    "test:broccolidb:api": "node --import tsx scripts/test-broccolidb-compaction-api-route.ts",
    "bench:inference-boundary": "node --import tsx scripts/bench-broccolidb-openai-inference-boundary.ts",
    "test:quota": "tsx tests/quota-pooling/test-gpt56-pooling.ts",
    "test:quota:real": "tsx tests/quota-pooling/test-live-pool-real.ts",
    "test:snake": "tsx tests/quota-pooling/test-snake-request.ts",
    "test:image": "tsx tests/quota-pooling/test-image-model-request.ts",
    "db:verify": "tsx scripts/verify-supabase-integrity.ts",
    "db:test": "tsx scripts/test-supabase-integration.ts",
    "db:push": "tsx scripts/push-migrations-direct.ts",
    "db:status": "tsx scripts/manage-migrations.ts --status",
    "db:migrate": "tsx scripts/manage-migrations.ts --apply",
    "db:dry-run": "tsx scripts/manage-migrations.ts --dry-run",
    "vercel:verify": "tsx scripts/verify-vercel-readiness.ts",
    "vault:populate": "tsx scripts/populate-vault-secrets.ts",
    "deploy:check": "npm run vercel:verify && npm run design:health && npm run lint && npm run build",
    "playbook": "tsx scripts/run-lifecycle-playbook.ts",
    "vercel:smoke": "tsx scripts/verify-deployment-smoke.ts",
    "vercel:env:sync": "tsx scripts/sync-vercel-env.ts",
    "vercel:env:print": "tsx scripts/sync-vercel-env.ts --print-cli",
    "vercel:deploy": "vercel",
    "vercel:deploy:prod": "vercel --prod"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3",
    "@stripe/stripe-js": "^9.14.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "clsx": "^2.1.1",
    "eslint": "^9",
    "eslint-config-next": "^15.5.23",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "next": "^15.5.23",
    "pg": "^8.23.0",
    "postcss": "^8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "wrangler": "^4.125.0"
  }
}
