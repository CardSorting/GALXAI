{
  "name": "galxai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "galxai": "./bin/galxai.mjs"
  },
  "scripts": {
    "predev": "kill $(lsof -ti:3000) 2>/dev/null || true",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:design": "npx -y impeccable detect src",
    "design:health": "tsx scripts/verify-design-health.ts",
    "design:hints": "tsx scripts/verify-design-health.ts --hints",
    "design:fix": "tsx scripts/autofix-design-slop.ts",
    "design:scorecard": "tsx scripts/generate-design-scorecard.ts",
    "worker:dev": "wrangler dev",
    "worker:build": "wrangler deploy --dry-run",
    "worker:deploy": "wrangler deploy",
    "worker:deploy:staging": "wrangler deploy --env staging",
    "worker:tail": "wrangler tail",
    "worker:test": "tsx scripts/test-cloudflare-workers.ts",
    "cf:bootstrap": "tsx scripts/bootstrap-cloudflare.ts",
    "test:router": "tsx scripts/validate-galxai-router.ts",
    "db:verify": "tsx scripts/verify-supabase-integrity.ts",
    "db:test": "tsx scripts/test-supabase-integration.ts",
    "db:push": "tsx scripts/push-migrations-direct.ts",
    "db:status": "tsx scripts/manage-migrations.ts --status",
    "db:migrate": "tsx scripts/manage-migrations.ts --apply",
    "db:dry-run": "tsx scripts/manage-migrations.ts --dry-run",
    "vercel:verify": "tsx scripts/verify-vercel-readiness.ts",
    "vault:populate": "tsx scripts/populate-vault-secrets.ts",
    "prebuild": "tsx scripts/verify-vercel-readiness.ts",
    "deploy:check": "npm run vercel:verify && npm run design:health && npm run lint && npm run build",
    "playbook": "tsx scripts/run-lifecycle-playbook.ts",
    "vercel:smoke": "tsx scripts/verify-deployment-smoke.ts",
    "vercel:env:sync": "tsx scripts/sync-vercel-env.ts",
    "vercel:env:print": "tsx scripts/sync-vercel-env.ts --print-cli",
    "vercel:deploy": "vercel",
    "vercel:deploy:prod": "vercel --prod"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@types/pg": "^8.23.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "next": "^15.5.23",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "^15.5.23",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "wrangler": "^4.125.0"
  }
}
