# ==============================================================================
# GALXAI: .vercelignore (Vercel Build Optimization & Asset Isolation)
# ==============================================================================

# Environment and Secret Files
.env
.env.*
.dev.vars
.dev.vars.*
wrangler.secrets*

# Cloudflare Workers & Edge Infrastructure files
.wrangler/
wrangler.toml
worker-configuration.d.ts

# Agents, Brain, and IDE Local Files
.agents/
.data/
.git/
.github/
.codex/
.impeccable/
.broccolidb/
.DS_Store
*.DS_Store

# Documentation & Knowledge Bases
docs/
README.md
DESIGN.md
DESIGN_SCORECARD.md
PRODUCT.md

# Standalone Scripts & Database Management (Executed locally / CI, not in Next.js bundle)
scripts/
supabase/
Dockerfile
docker-compose.yml
skills-lock.json

# Caches, Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tsconfig.tsbuildinfo
*.tsbuildinfo
