# ==============================================================================
# GALXAI: .vercelignore (Vercel Build Optimization & Asset Isolation)
# ==============================================================================

# Environment and Secret Files
.env
.env.*
.dev.vars
.dev.vars.*
wrangler.secrets*

# Cloudflare Workers & Edge Infrastructure files (Root Only)
/.wrangler/
/wrangler.toml
/worker-configuration.d.ts
/workers/

# Agents, Brain, and IDE Local Files (Root Only)
/.agents/
/.data/
/.git/
/.github/
/.codex/
/.impeccable/
/.broccolidb/
/.relay/
.DS_Store
*.DS_Store

# Root Documentation & Metadata (Root Only - Never ignore src/app/docs or src/components/docs)
/docs/
/internal/
/README.md
/DESIGN.md
/DESIGN_SCORECARD.md
/PRODUCT.md

# Standalone Scripts & Migrations (Root Only - Never ignore src/lib/supabase or src/utils/supabase)
/scripts/
/supabase/
/Dockerfile
/docker-compose.yml
/skills-lock.json

# Caches, Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tsconfig.tsbuildinfo
*.tsbuildinfo
