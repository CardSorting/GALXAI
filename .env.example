# ==============================================================================
# GALXAI: Master Environment Variable Specification for Vercel & Production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & PUBLIC URLs (Configured in Vercel Environment Variables)
# ------------------------------------------------------------------------------
# Production App URL (e.g., https://galx.ai or https://galxai.vercel.app)
NEXT_PUBLIC_APP_URL=https://galx.ai

# Canonical application API base URL for SDK clients
GALXAI_BASE_URL=https://galx.ai/v1

# Separate Cloudflare Worker deployment; not the application SDK base URL
NEXT_PUBLIC_GALX_EDGE_URL=https://api.galx.ai

# Multimodal Public Asset Storage / R2 CDN URL
PUBLIC_ASSETS_URL=https://assets.galx.ai

# Cloudflare R2 Continuous Learning & Model Training Dataset Bucket ($0 Egress)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_TRAINING_BUCKET_NAME=galxai-training-datasets
R2_PUBLIC_DOMAIN=https://datasets.galx.ai

# ------------------------------------------------------------------------------
# 2. SUPABASE BACKEND INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Supabase Project HTTPS Endpoint
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key / Publishable Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here

# Supabase Service Role Secret Key (Serverless Functions Only - NEVER expose to browser).
# A publishable key in this variable is rejected and cannot become admin authority.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here

# PostgreSQL Direct / Pooler Connection String (e.g., Transaction pooler port 6543)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# TLS is always required. For production, download the project CA certificate
# from Supabase Database Settings, store its PEM with newlines escaped as \n,
# and switch the mode to verify-full.
SUPABASE_DB_SSL_MODE=require
SUPABASE_DB_CA_CERT=

# Database Pool Settings (Optional)
SUPABASE_POOL_SIZE=20
SUPABASE_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 3. PRIVATE VAULT AND SHARD IDENTITY CONFIGURATION
# ------------------------------------------------------------------------------
# Versioned key slots for deploy -> rewrap -> prune rotation. Supply at deploy
# time from a secret manager and generate at least 32 random bytes per version.
# GALX_VAULT_MASTER_SECRET/GALX_VAULT_KEY are legacy v1 inputs only.
GALX_VAULT_MASTER_SECRET=
GALX_VAULT_KEY=
GALX_VAULT_KEY_V1=
GALX_VAULT_KEY_V2=
GALX_VAULT_ACTIVE_KEY_VERSION=v1
# Separate HMAC key for stable, non-reversible provider-account shard IDs.
GALX_SHARD_ID_SECRET=
GALX_AUDIT_SIGNING_SECRET=
# Provider enrollment accepts no token environment inputs. Manually sign in
# inside Relay Desktops, then choose Enroll shard. Renew expired sessions there.
# See docs/maintainers/RELAY_CREDENTIAL_ENROLLMENT.md.
# Maximum age of a worker's in-memory shard routing projection before a
# single-flight refresh from the PostgreSQL authority (250-60000 ms).
GALX_SHARD_PROJECTION_MAX_STALENESS_MS=5000

# ------------------------------------------------------------------------------
# 4. OPTIONAL UPSTREAM ROOT FALLBACK KEYS
# ------------------------------------------------------------------------------
# Optional retained adapter configuration. These keys do not enroll managed
# shards or bypass manual desktop provenance and capability checks.
OPENAI_API_KEY=
XAI_API_KEY=
GALX_API_KEY=

# Optional edge transport URL. Long-lived shard credentials are not synchronized there.
LUMI_EDGE_WORKER_URL=

# Host Always-On VM Relay Daemon
# - Local Development: http://localhost:3001
# - Remote deployments: configure the verified private relay origin, such as https://relay.galx.ai
VM_RELAY_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 5. GALX ACCOUNT SOCIAL PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# GitHub OAuth App Credentials (for Supabase Auth & Local dev)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth App Credentials (for Supabase Auth & Local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GALX account OAuth is separate from provider credentials used by the relay.
# Provider OAuth URL/callback/PAR/refresh endpoints are closed. Do not configure
# application provider-client IDs or redirects as a shard enrollment workaround.
# Manual sign-in in Relay Desktops owns provider login and renewal.

# ------------------------------------------------------------------------------
# 6. STRIPE PAYMENT INFRASTRUCTURE & PCI-DSS SAQ-A CHECKOUT
# ------------------------------------------------------------------------------
# Stripe Secret Key (Server-side API calls: Checkout sessions, Customer portal, Refunds)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Publishable Key (Client-side Stripe.js / Elements)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Webhook Signing Secret (HMAC-SHA256 verification for /api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Nova Developer Access uses the recurring Price with lookup key
# galx_nova_developer_monthly_v1. The application resolves it server-side;
# keep any provider object IDs out of public configuration.

# ------------------------------------------------------------------------------
# 7. CLOUDFLARE R2 CONTINUOUS LEARNING STORAGE & ZERO-EGRESS ML SUBSTRATE
# ------------------------------------------------------------------------------
# Cloudflare Account ID (Found in Cloudflare Dashboard URL or Overview)
R2_ACCOUNT_ID=your_cloudflare_account_id_here

# Cloudflare R2 S3-Compatible API Credentials (Permissions: Object Read & Write)
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# Cloudflare R2 Workspace Buckets & Endpoints ($0 Egress Bandwidth)
R2_TRAINING_BUCKET_NAME=galxai-training-datasets
R2_BUCKET_NAME=galxai-training-datasets
R2_PUBLIC_DOMAIN=https://datasets.galx.ai
R2_ASSETS_BUCKET_NAME=galxai-assets
R2_WEBAPPS_BUCKET_NAME=galx-user-webapps
R2_DREAMBEES_BUCKET_NAME=dreambees
R2_STICKER_BUCKET_NAME=sticker

# Internal Admin Secret Key (Gating /api/internal/training/* endpoints)
GALX_INTERNAL_ADMIN_KEY=your_secure_internal_admin_key_32b_here

# Relay access: required for non-loopback listeners (including Docker).
# With no RELAY_ADMIN_API_KEYS, the first RELAY_API_KEYS entry is administrator;
# additional entries can submit inference and access only their own jobs.
# Configure separate high-entropy keys through your deployment's secret store.
RELAY_API_KEYS=
RELAY_ADMIN_API_KEYS=
# Browser integrations must explicitly allow exact origins; no wildcard support.
# Same-origin dashboard access needs no allowlist entry.
RELAY_ALLOWED_ORIGINS=
# Host credential discovery is closed; keep false. Setting true is rejected,
# including for development of the managed fleet. Use isolated test fixtures.
RELAY_DISCOVER_HOST_CREDENTIALS=false
# App-side inference credential; use an entry from RELAY_API_KEYS, not an admin key.
VM_RELAY_API_KEY=
