# ==============================================================================
# GALXAI: Master Environment Variable Specification for Vercel & Production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & PUBLIC URLs (Configured in Vercel Environment Variables)
# ------------------------------------------------------------------------------
# Production App URL (e.g., https://galx.ai or https://galxai.vercel.app)
NEXT_PUBLIC_APP_URL=https://galx.ai

# Cloudflare Edge Gateway URL for distributed inference (/v1/chat/completions)
NEXT_PUBLIC_GALX_EDGE_URL=https://api.galx.ai

# Multimodal Public Asset Storage / R2 CDN URL
PUBLIC_ASSETS_URL=https://assets.galx.ai

# Cloudflare R2 Continuous Learning & Model Training Dataset Bucket ($0 Egress)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_TRAINING_BUCKET_NAME=galxai-training-datasets
R2_PUBLIC_DOMAIN=https://datasets.galx.ai

# ------------------------------------------------------------------------------
# 2. SUPABASE BACKEND INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Supabase Project HTTPS Endpoint
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key / Publishable Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here

# Supabase Service Role Secret Key (Serverless Functions Only - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here

# PostgreSQL Direct / Pooler Connection String (e.g., Transaction pooler port 6543)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Database Pool Settings (Optional)
SUPABASE_POOL_SIZE=20
SUPABASE_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 3. VAULT CRYPTOGRAPHY & SOC2 ZERO-DATA-RETENTION SECRETS
# ------------------------------------------------------------------------------
# Master Encryption Secret (32-byte secret used for HKDF-SHA256 derivation & AES-256-GCM vault isolation)
GALX_VAULT_MASTER_SECRET=galxai-apex-vault-master-secret-key-32b
GALX_VAULT_KEY=galxai-apex-vault-master-secret-key-32b
GALX_VAULT_ACTIVE_KEY_VERSION=v1

# ------------------------------------------------------------------------------
# 4. OPTIONAL UPSTREAM ROOT FALLBACK KEYS
# ------------------------------------------------------------------------------
# Upstream root API keys (BYOQ user shards take dynamic precedence)
OPENAI_API_KEY=
XAI_API_KEY=
GALX_API_KEY=

# ------------------------------------------------------------------------------
# 5. OAUTH 2.0 PKCE PROVIDER CONFIGURATION (OpenAI & xAI Grok)
# ------------------------------------------------------------------------------
# OpenAI Registered OAuth Client ID & Allowed Redirect URI
OPENAI_OAUTH_CLIENT_ID=
OPENAI_OAUTH_REDIRECT_URI=https://galx.ai/auth/callback
OPENAI_OAUTH_SCOPES=openid profile email offline_access

# xAI Grok Registered OAuth Client ID & Allowed Redirect URI
XAI_OAUTH_CLIENT_ID=
XAI_OAUTH_REDIRECT_URI=https://galx.ai/auth/callback
XAI_OAUTH_SCOPES=openid profile email offline_access

# ------------------------------------------------------------------------------
# 6. STRIPE PAYMENT INFRASTRUCTURE & PCI-DSS SAQ-A CHECKOUT
# ------------------------------------------------------------------------------
# Stripe Secret Key (Server-side API calls: Checkout sessions, Customer portal, Refunds)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Publishable Key (Client-side Stripe.js / Elements)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Webhook Signing Secret (HMAC-SHA256 verification for /api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ------------------------------------------------------------------------------
# 7. CLOUDFLARE R2 CONTINUOUS LEARNING STORAGE & ZERO-EGRESS ML SUBSTRATE
# ------------------------------------------------------------------------------
# Cloudflare Account ID (Found in Cloudflare Dashboard URL or Overview)
R2_ACCOUNT_ID=your_cloudflare_account_id_here

# Cloudflare R2 S3-Compatible API Credentials (Permissions: Object Read & Write)
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# Cloudflare R2 Workspace Buckets & Endpoints ($0 Egress Bandwidth)
R2_TRAINING_BUCKET_NAME=galxai-training-datasets
R2_BUCKET_NAME=galxai-training-datasets
R2_PUBLIC_DOMAIN=https://datasets.galx.ai
R2_ASSETS_BUCKET_NAME=galxai-assets
R2_WEBAPPS_BUCKET_NAME=galx-user-webapps
R2_DREAMBEES_BUCKET_NAME=dreambees
R2_STICKER_BUCKET_NAME=sticker

# Internal Admin Secret Key (Gating /api/internal/training/* endpoints)
GALX_INTERNAL_ADMIN_KEY=your_secure_internal_admin_key_32b_here



