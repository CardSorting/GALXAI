# Pinned multi-platform official Node image; update deliberately and rebuild both targets.
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS builder
WORKDIR /build
COPY docker/relay-pools/package*.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY src/relay ./src/relay
COPY src/core/broccolidb ./src/core/broccolidb
COPY src/lib/security/image-artifact.ts ./src/lib/security/image-artifact.ts
RUN ./node_modules/.bin/esbuild src/relay/relay-server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/relay.mjs --packages=external

FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS runtime
WORKDIR /app
COPY docker/relay-pools/package*.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund && npm cache clean --force
COPY --from=builder /build/dist/relay.mjs ./relay.mjs
COPY docker/relay-pools/entrypoint.mjs ./entrypoint.mjs
ENV NODE_ENV=production
USER 1000:1000
EXPOSE 3001
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 CMD node -e "fetch('http://127.0.0.1:3001/health/live',{signal:AbortSignal.timeout(2000)}).then(r=>{if(r.status!==200)process.exit(1)}).catch(()=>process.exit(1))"
ENTRYPOINT ["node", "/app/entrypoint.mjs"]

FROM runtime AS premium
COPY docker/relay-pools/premium.json ./pool.json
LABEL org.opencontainers.image.title="GALX Premium Relay" io.galx.pool="premium" io.galx.stage="awaiting-central-authorization"

FROM runtime AS standard
COPY docker/relay-pools/standard.json ./pool.json
LABEL org.opencontainers.image.title="GALX Standard Relay" io.galx.pool="standard" io.galx.stage="awaiting-central-authorization"
