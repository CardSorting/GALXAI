# ==============================================================================
# GALXAI: Master .gitignore & Paranoid Credential Leak Prevention
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CREDENTIALS, SECRETS & ENVIRONMENT FILES (NEVER COMMIT)
# ------------------------------------------------------------------------------
# All .env variants
*.env
*.env.local
*.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Explicitly whitelist examples / templates only
!.env.template

# Secret tokens, API keys, credentials & service accounts
*.secret
*.secrets
*.secret.*
secrets.json
credentials.json
service-account*.json
gcp-key*.json
aws-credentials*
*.key
*.pem
*.cert
*.crt
*.pfx
*.p12
id_rsa*
id_ed25519*

# Cloudflare & Edge Worker local secret variables
.dev.vars
.dev.vars.*
.wrangler/
wrangler.secrets*

# Vercel & Serverless Deployment state
.vercel/
.serverless/

# Supabase local environment cache & branches
.supabase/
supabase/.temp/
supabase/.branches/

# ------------------------------------------------------------------------------
# 2. DATABASE DUMPS, WAL & EPHEMERAL STORAGE
# ------------------------------------------------------------------------------
.data/
.galxai_cache/
# Legacy credential cache is forbidden; keep ignored as defense against accidental recommit.
.galx-shards.json
.broccolidb/
.relay/
*.db
*.sqlite
*.sqlite3
*.wal
*.dump
*.sql.bak
*.sql.dump
dump.sql
backup.sql

# ------------------------------------------------------------------------------
# 3. DEPENDENCIES & PACKAGE MANAGERS
# ------------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml

# ------------------------------------------------------------------------------
# 4. BUILD ARTIFACTS & TESTING
# ------------------------------------------------------------------------------
# Next.js & Web builds
/.next/
/out/
/build/
/dist/

# Testing & Coverage
/coverage
*.lcov
.nyc_output

# TypeScript
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# 5. LOGS, CRASH DUMPS & DEBUGGING
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 6. OS & IDE METADATA
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Impeccable local state
.impeccable/*.local.json
.impeccable/hook.cache.json
/.impeccable/review/

# Local LinkedIn brand assets
/public/brand/linkedin/

# Python helper compilation
__pycache__/

.vercel

# Raw incident captures may contain private runtime or user data.
/post-mortem/**/evidence/raw/

# Stripe Projects local caches and credential state

# Separate migration context CLI cache
deploy/relay-execution/supabase/.temp/
scripts/__pycache__/

.projects/cache
.projects/vault
.projects/state.test.json
.projects/state.local.test.json
.env
.env.*
!.env.example
