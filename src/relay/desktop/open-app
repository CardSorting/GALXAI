#!/bin/bash
set -euo pipefail
case "${1:-}" in
  terminal) pattern='xfce4-terminal.Xfce4-terminal' ;;
  chrome) pattern='google-chrome.Google-chrome' ;;
  signin) pattern='GALX Sign in' ;;
  *) exit 2 ;;
esac
focus() { if [ "$1" = signin ]; then wmctrl -Fa "$pattern"; else wmctrl -xa "$pattern"; fi; }
if focus "$1"; then exit 0; fi
/opt/galx-desktop/launch-app "$1" >"/tmp/launch-$1.log" 2>&1 </dev/null &
app_pid=$!
for i in {1..60}; do
  if focus "$1"; then exit 0; fi
  if ! kill -0 "$app_pid" 2>/dev/null; then exit 1; fi
  sleep .15
done
exit 1
