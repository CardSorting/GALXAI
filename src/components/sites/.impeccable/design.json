    {
      "name": "Prompt composer",
      "kind": "input",
      "refersTo": "composer",
      "description": "One continuous input surface with a visible focus border and send action.",
      "html": "<div class=\"ds-composer\"><textarea aria-label=\"Describe your Site or ask for a change\" placeholder=\"Tell us about your Site…\" rows=\"3\"></textarea><div class=\"ds-composer-actions\"><span>Your idea, in your words</span><button aria-label=\"Send message\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 7-7 7 7M12 19V5\"/></svg></button></div></div>",
      "css": ".ds-composer{border:1px solid rgba(255,255,255,.17);border-radius:10px;background:#07080d;padding:14px 12px 10px;font-family:var(--font-inter),sans-serif}.ds-composer:focus-within{border-color:#818cf8}.ds-composer textarea{display:block;width:100%;resize:vertical;min-height:80px;max-height:170px;border:0;background:transparent;color:#f3f4f6;outline:0;font:13px/1.6 var(--font-inter),sans-serif;padding:0 2px;caret-color:#a5b4fc}.ds-composer textarea::placeholder{color:#9ca3af}.ds-composer-actions{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:8px}.ds-composer-actions>span{font-size:10px;color:#9ca3af}.ds-composer-actions button{display:flex;align-items:center;gap:9px;border:0;border-radius:6px;padding:8px 10px;min-height:34px;background:#4f46e5;color:#fff;cursor:pointer}.ds-composer-actions button:hover{background:#4338ca}.ds-composer-actions button:focus-visible{outline:2px solid #a5b4fc;outline-offset:3px}.ds-composer-actions button:disabled{opacity:.45;cursor:not-allowed}.ds-composer-actions svg{width:16px;height:16px;stroke-width:1.7}"
    },
