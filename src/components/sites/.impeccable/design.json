      "css": ".ds-state{font-size:10px;color:#9ca3af;padding:3px 6px;background:#14192d;border-radius:3px;white-space:nowrap;font-family:var(--font-inter),sans-serif}.ds-state-live{color:#6ee7b7}"
    },
