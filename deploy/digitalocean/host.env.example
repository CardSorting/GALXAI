# Private operator file. Copy to /opt/galx/deploy/digitalocean/host.env and
# replace every placeholder before starting the stack. Never commit the copy.
GALX_CENTRAL_CONFIG_FILE=/opt/galx/config/components/central.json
GALX_PREMIUM_RUNTIME_CONFIG_FILE=/opt/galx/config/components/premium-runtime.json
GALX_PREMIUM_MONITOR_CONFIG_FILE=/opt/galx/config/components/premium-monitor.json
GALX_DOCKER_SOCKET_GID=REPLACE_WITH_DOCKER_SOCKET_GROUP_ID

GALX_CENTRAL_IMAGE=galxai-relay-central@sha256:REPLACE_WITH_REVIEWED_AMD64_DIGEST
GALX_PREMIUM_RUNTIME_IMAGE=galxai-relay-premium@sha256:REPLACE_WITH_REVIEWED_AMD64_DIGEST
GALX_PREMIUM_MONITOR_IMAGE=galxai-monitor-premium@sha256:REPLACE_WITH_REVIEWED_AMD64_DIGEST
GALX_CADDY_IMAGE=caddy:2.11.4-alpine@sha256:REPLACE_WITH_REVIEWED_AMD64_DIGEST

GALX_CADDYFILE=/opt/galx/deploy/digitalocean/Caddyfile
GALX_CENTRAL_HOST=central-relay.example.com
GALX_PREMIUM_HOST=premium-relay.example.com
GALX_TLS_EMAIL=ops@example.com
