FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS builder
WORKDIR /build
COPY docker/relay-pools/package*.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY src/relay ./src/relay
COPY src/core/broccolidb ./src/core/broccolidb
COPY src/lib/security/image-artifact.ts ./src/lib/security/image-artifact.ts
RUN ./node_modules/.bin/esbuild src/relay/pool-entry.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/service.mjs --packages=external

FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS service
WORKDIR /app
COPY docker/relay-pools/package*.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund && npm cache clean --force && mkdir /state && chown node:node /state
COPY --from=builder /build/dist/service.mjs ./service.mjs
COPY docker/relay-pools/active-entrypoint.mjs ./entrypoint.mjs
ENV NODE_ENV=production
USER 1000:1000
STOPSIGNAL SIGTERM
ENTRYPOINT ["node","/app/entrypoint.mjs"]

FROM service AS central
COPY docker/relay-pools/central.json ./component.json
EXPOSE 3000
LABEL io.galx.component="central"

FROM service AS premium-runtime
COPY docker/relay-pools/premium-runtime.json ./component.json
EXPOSE 3001
LABEL io.galx.component="runtime" io.galx.pool="premium"

FROM service AS standard-runtime
COPY docker/relay-pools/standard-runtime.json ./component.json
EXPOSE 3001
LABEL io.galx.component="runtime" io.galx.pool="standard"

FROM service AS monitor
USER root
RUN apk add --no-cache docker-cli=29.5.3-r1
COPY src/relay/pool-monitor.html src/relay/pool-monitor.js src/relay/pool-monitor-model.js src/relay/pool-monitor.css src/relay/pool-monitor-login.html src/relay/pool-monitor-login.js src/relay/pool-monitor-access.css ./
COPY src/relay/pool-desktop.html src/relay/pool-desktop.js ./
COPY src/relay/desktops.html src/relay/desktops.js src/relay/desktop-login.html src/relay/desktop-login.js src/relay/desktop-activity.js src/relay/desktop-organizer.js src/relay/desktop-organizer.css ./
COPY src/relay/desktop ./desktop
USER 1000:1000

FROM monitor AS premium-monitor
COPY docker/relay-pools/premium-monitor.json ./component.json
LABEL io.galx.component="monitor" io.galx.pool="premium"

FROM monitor AS standard-monitor
COPY docker/relay-pools/standard-monitor.json ./component.json
LABEL io.galx.component="monitor" io.galx.pool="standard"
